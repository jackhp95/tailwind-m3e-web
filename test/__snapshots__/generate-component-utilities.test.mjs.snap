# CSS Custom Properties Reference

One Tailwind v4 \`@utility\` rule is generated for each property below.
Usage: \`class="<property-name-without-dashes>-[<value>]"\`

## \`m3e-button\`

| Property | Type | Description |
| --- | --- | --- |
| \`--m3e-button-container-color\` | \`color\` | Container fill colour. |
| \`--m3e-button-label-text-color\` | \`color\` | Label colour. |
| \`--m3e-button-shape\` | \`length\` | Corner radius. |
| \`--m3e-button-elevation\` | \`*\` | Shadow elevation. |
| \`--m3e-button-duration\` | \`time\` | State-change duration. |

## \`m3e-icon\`

| Property | Type | Description |
| --- | --- | --- |
| \`--m3e-icon-size\` | \`length\` | Glyph size. |
| \`--m3e-icon-color\` | \`color\` | Glyph colour. |
"
`;

exports[`generate-component-utilities > emitUtilities output is byte-stable across two runs (snapshot) 1`] = `
"/*
 * AUTOGENERATED — DO NOT EDIT
 *
 * Generated by bin/generate-component-utilities.mjs from
 * node_modules/@m3e/web/dist/custom-elements.json.
 *
 * One Tailwind v4 @utility rule per public --m3e-* CSS custom property,
 * sorted alphabetically. Re-run \`pnpm run generate:utilities\` after
 * bumping @m3e/web.
 */

@utility m3e-button-container-color-* {
  --m3e-button-container-color: --value(color, --color-*);
}
@utility m3e-button-duration-* {
  --m3e-button-duration: --value(time, --duration-*);
}
@utility m3e-button-elevation-* {
  --m3e-button-elevation: --value(*);
}
@utility m3e-button-label-text-color-* {
  --m3e-button-label-text-color: --value(color, --color-*);
}
@utility m3e-button-shape-* {
  --m3e-button-shape: --value(length, --radius-*);
}
@utility m3e-icon-color-* {
  --m3e-icon-color: --value(color, --color-*);
}
@utility m3e-icon-size-* {
  --m3e-icon-size: --value(length, --spacing-*);
}
"
`;
