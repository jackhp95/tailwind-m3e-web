@utility m3e-button-container-color-* {
  --alpha: calc(--modifier(integer) * 1%);
  --m3e-button-container-color: --alpha(--value([color], --color-*) / var(--alpha, 100%));
}

@utility m3e-button-container-color-on-scroll-* {
  --alpha: calc(--modifier(integer) * 1%);
  --m3e-button-container-color-on-scroll: --alpha(--value([color], --color-*) / var(--alpha, 100%));
}

@utility m3e-button-duration-* {
  --m3e-button-duration: --value([time], --transition-duration-*);
}

@utility m3e-button-elevation-* {
  --m3e-button-elevation: --value([*], --shadow-*);
}

@utility m3e-button-label-text-color-* {
  --alpha: calc(--modifier(integer) * 1%);
  --m3e-button-label-text-color: --alpha(--value([color], --color-*) / var(--alpha, 100%));
}

@utility m3e-button-shape-* {
  --m3e-button-shape: --value([length], --radius-*);
}

@utility m3e-icon-color-* {
  --alpha: calc(--modifier(integer) * 1%);
  --m3e-icon-color: --alpha(--value([color], --color-*) / var(--alpha, 100%));
}

@utility m3e-icon-size-* {
  --m3e-icon-size: --value([length]);
}
